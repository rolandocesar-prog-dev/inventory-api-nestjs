# Copia este archivo como .env. Nunca subas .env al repositorio.
NODE_ENV=development
PORT=3000

# PostgreSQL del docker-compose.yml (publicado en 127.0.0.1:5443)
POSTGRES_USER=inventory
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=inventory
DATABASE_URL=postgresql://inventory:cambia-esta-contrasena@localhost:5443/inventory

# Base aparte para las pruebas e2e (se crea sola con el docker-compose.yml)
TEST_DATABASE_URL=postgresql://inventory:cambia-esta-contrasena@localhost:5443/inventory_test

# Autenticación: genera uno con  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-valor-aleatorio-de-al-menos-32-caracteres

# Admin inicial (npm run seed o docker compose). Opcional; al menos 10 caracteres.
ADMIN_EMAIL=admin@inventario.test
ADMIN_PASSWORD=cambia-esta-clave-de-admin

# Logs JSON: fatal, error, warn, info, debug, trace o silent
LOG_LEVEL=info

# Solo detrás de un proxy (Render): limita el login por la IP real del cliente
TRUST_PROXY=false

# Orígenes web que pueden llamar a la API (CORS), separados por comas; vacío = sin CORS
# p. ej. la versión web del escáner de facturas: http://localhost:8080
CORS_ORIGINS=

# Operador de demostración con catálogo de ejemplo (opcional)
DEMO_EMAIL=demo@inventario.test
DEMO_PASSWORD=demo-inventario-2026
